{
    // Firmware tasks, run in firmware/. The build tasks mirror
    // firmware/.vscode/tasks.json: the debug configs generated by
    // `cargo xtask ide` use their labels as preLaunchTask.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Firmware IDE: use board from config.toml",
            "type": "shell",
            "command": "cargo xtask ide",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "presentation": { "reveal": "silent", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Firmware IDE: use PC board",
            "type": "shell",
            "command": "cargo xtask ide --board pc",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "presentation": { "reveal": "silent", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Build: PC firmware (debug)",
            "type": "shell",
            "command": "cargo xtask build --board pc --debug",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: ESP firmware (release)",
            "type": "shell",
            "command": "cargo xtask build --board esp",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: ESP firmware (debug)",
            "type": "shell",
            "command": "cargo xtask build --board esp --debug",
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "dependsOn": ["Fix: ESP JTAG USB permissions"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Fix: ESP JTAG USB permissions",
            "type": "shell",
            "command": "for f in /sys/bus/usb/devices/*/idVendor; do if [ \"$(cat $f 2>/dev/null)\" = \"303a\" ]; then bus=$(cat $(dirname $f)/busnum); dev=$(cat $(dirname $f)/devnum); sudo chmod a+rw /dev/bus/usb/$(printf '%03d' $bus)/$(printf '%03d' $dev); fi; done",
            "presentation": { "reveal": "silent", "panel": "shared" }
        }
    ]
}
